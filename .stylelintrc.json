{
  "extends": [
    "stylelint-config-standard",
    "stylelint-config-tailwindcss"
  ],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "apply",
          "responsive",
          "screen",
          "layer",
          "theme",
          "custom-variant"
        ]
      }
    ]
  },
  "ignoreFiles": [
    "node_modules/**",
    ".next/**",
    "build/**",
    "dist/**"
  ]
}
